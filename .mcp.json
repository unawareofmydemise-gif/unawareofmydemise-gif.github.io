{
  "mcpServers": {
    "godot": {
      "command": "node",
      "args": ["/opt/uomd-tools/mcp/node_modules/godot-mcp-runtime/dist/index.js"],
      "env": {
        "GODOT_PATH": "/usr/local/bin/uomd-godot-display",
        "DISPLAY": ":99",
        "VK_ICD_FILENAMES": "/opt/lavapipe/lvp_icd.json"
      }
    },
    "uomd-blender": {
      "command": "/usr/local/bin/uomd-blender-mcp",
      "args": []
    },
    "godot-ai": {
      "command": "/opt/uomd-tools/godot-ai-venv/bin/godot-ai",
      "args": ["attach", "--port", "8000", "--ws-port", "9500", "--disable-telemetry"],
      "env": {
        "GODOT_AI_DISABLE_TELEMETRY": "true",
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
